# Agent Orchestrator — copy to .env.local and populate.
# Source before running: set -a && source .env.local && set +a

# Required for GitHub (PRs, issues). Or use: gh auth login
GITHUB_TOKEN=

# Required for claude-code agent
ANTHROPIC_API_KEY=

# Optional: only if using Linear tracker
# LINEAR_API_KEY=

# Optional: only if using Slack notifier
# SLACK_WEBHOOK_URL=

# Optional: only if using Codex agent (defaults.agent: codex)
# OPENAI_API_KEY=
